# Configuration Trading Floor Desk (100% Local Paper Trading)
PORT=4080
PAPER_EQUITY=10000
TZ=Europe/Paris
SYMBOLS=BTCUSDT,ETHUSDT,EURUSD,GBPUSD,USDCHF,XAUUSD
SCAN_INTERVAL_MIN=5
MONITOR_INTERVAL_SEC=5

# Optionnel : clés LLM pour personnaliser les voix des 8 agents
LLM_PROVIDER=auto
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Optionnel : relais Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_TOKEN_LEAD=
# DAILY_DD_ALERT_PCT=0.03

# Lot sizing basé sur l'Equity & distance SL (compte 85k$ : 0.5% - 1% = 425$ - 850$)
RISK_BASED_SIZING=true
RISK_PERCENT=0.0075
MAX_LOT_CAP=10

# Strategy_Optimizer (méta-stratège asynchrone)
OPTIMIZER_EVERY_N_TRADES=10
OPTIMIZER_EOD_HOUR=22
OPTIMIZER_WINDOW=50
OPTIMIZER_MIN_SAMPLE=8
OPTIMIZER_AUTO_APPLY=true

# Accès mobile à distance (Cloudflare Tunnel + PIN)
# DESK_ACCESS_PIN=123456
# DESK_SESSION_SECRET=
# CF_TUNNEL_TOKEN=
